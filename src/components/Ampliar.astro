---
// Clicar numa imagem do capítulo abre ela em tela cheia (como no Writebook)
---

<dialog class="ampliar" aria-label="Imagem ampliada"></dialog>

<script>
  const dialogo = document.querySelector<HTMLDialogElement>('dialog.ampliar');

  function abrir(conteudo: HTMLElement) {
    if (!dialogo) return;
    dialogo.replaceChildren(conteudo);
    dialogo.showModal();
  }

  // Imagens comuns: mostra só a imagem
  document.querySelectorAll<HTMLImageElement>('.prosa img').forEach((img) => {
    if (img.closest('.quadro')) return;
    img.addEventListener('click', () => {
      const grande = document.createElement('img');
      grande.src = img.currentSrc || img.src;
      grande.alt = img.alt;
      abrir(grande);
    });
  });

  // Imagens com destaque (componente Interface): amplia a imagem junto com o destaque
  document.querySelectorAll<HTMLElement>('.prosa .quadro').forEach((quadro) => {
    quadro.addEventListener('click', () => {
      const copia = quadro.cloneNode(true) as HTMLElement;
      copia.classList.add('quadro-ampliado');
      abrir(copia);
    });
  });

  // Fecha ao clicar em qualquer lugar (o Esc já fecha sozinho)
  dialogo?.addEventListener('click', () => dialogo.close());
</script>

<style>
  .ampliar {
    max-width: 95vw;
    max-height: 95vh;
    padding: 0;
    border: none;
    background: transparent;
    overflow: hidden;
    cursor: zoom-out;
  }
  .ampliar::backdrop {
    background: rgb(10 8 6 / 0.88);
  }
  /* Ocupa a tela toda e encaixa a imagem sem distorcer */
  .ampliar :global(> img) {
    display: block;
    width: 95vw;
    height: 95vh;
    object-fit: contain;
  }
  /* Imagem com destaque: o maior tamanho que cabe na tela mantendo a proporção */
  .ampliar :global(.quadro-ampliado) {
    width: min(95vw, calc(95vh * var(--proporcao, 1.7778)));
    cursor: zoom-out;
  }
</style>
