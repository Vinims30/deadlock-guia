---
// Clicar numa imagem do capítulo abre ela em tela cheia (como no Writebook)
---

<dialog class="ampliar" aria-label="Imagem ampliada"></dialog>

<script>
  import { desenharDestaques } from '../lib/destaques';

  const dialogo = document.querySelector<HTMLDialogElement>('dialog.ampliar');

  // Monta a imagem grande do zero, no maior tamanho que cabe na tela
  function abrir(src: string, alt: string, largura: number, altura: number, destaques = '') {
    if (!dialogo) return;
    const caixa = document.createElement('div');
    caixa.className = 'ampliada';
    caixa.style.aspectRatio = `${largura} / ${altura}`;
    caixa.style.width = `min(95vw, calc(95vh * ${largura / altura}))`;

    const img = document.createElement('img');
    img.src = src;
    img.alt = alt;
    caixa.append(img);
    caixa.insertAdjacentHTML('beforeend', destaques);

    dialogo.replaceChildren(caixa);
    dialogo.showModal();
  }

  // Imagens comuns
  document.querySelectorAll<HTMLImageElement>('.prosa img').forEach((img) => {
    if (img.closest('.quadro')) return;
    img.addEventListener('click', () => {
      abrir(img.currentSrc || img.src, img.alt, img.naturalWidth || 16, img.naturalHeight || 9);
    });
  });

  // Imagens com destaque (componente Interface): mostra a tela inteira com o destaque
  document.querySelectorAll<HTMLElement>('.prosa .quadro').forEach((quadro) => {
    quadro.addEventListener('click', () => {
      const { ampliar = '', largura = '16', altura = '9', areas = '[]' } = quadro.dataset;
      const alt = quadro.querySelector('img')?.alt ?? '';
      abrir(ampliar, alt, Number(largura), Number(altura), desenharDestaques(JSON.parse(areas)));
    });
  });

  // Fecha ao clicar em qualquer lugar (o Esc já fecha sozinho)
  dialogo?.addEventListener('click', () => dialogo.close());
</script>

<style>
  .ampliar {
    max-width: none;
    max-height: none;
    padding: 0;
    border: none;
    background: transparent;
    overflow: visible;
    cursor: zoom-out;
  }
  .ampliar::backdrop {
    background: rgb(10 8 6 / 0.88);
  }
  .ampliar :global(.ampliada) {
    position: relative;
  }
  .ampliar :global(.ampliada img) {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 8px;
  }
</style>
