---
// Clicar numa imagem do capítulo abre ela em tela cheia (como no Writebook)
---

<dialog class="ampliar" aria-label="Imagem ampliada"></dialog>

<script>
  import { desenharDestaques } from '../lib/destaques';

  const dialogo = document.querySelector<HTMLDialogElement>('dialog.ampliar');

  // Monta a imagem grande do zero, no maior tamanho que cabe na tela.
  // No celular em pé, uma imagem deitada ficaria do tamanho da página; então ela
  // aparece com 70% da altura da tela e dá para arrastar para os lados.
  function abrir(src: string, alt: string, largura: number, altura: number, destaques = '', centroX = 50) {
    if (!dialogo) return;
    const proporcao = largura / altura;
    const celularEmPe = innerWidth < innerHeight && innerWidth < 800 && proporcao > 1.2;
    const caixa = document.createElement('div');
    caixa.className = 'ampliada';
    caixa.style.aspectRatio = `${largura} / ${altura}`;
    caixa.style.width = celularEmPe
      ? `${Math.min(innerHeight * 0.7 * proporcao, largura)}px`
      : `min(95vw, calc(95vh * ${proporcao}))`;
    dialogo.classList.toggle('arrastar', celularEmPe);

    const img = document.createElement('img');
    img.src = src;
    img.alt = alt;
    caixa.append(img);
    caixa.insertAdjacentHTML('beforeend', destaques);

    dialogo.replaceChildren(caixa);
    dialogo.showModal();
    // Começa mostrando o destaque
    if (celularEmPe) dialogo.scrollLeft = (caixa.offsetWidth * centroX) / 100 - innerWidth / 2;
  }

  // Imagens comuns
  document.querySelectorAll<HTMLImageElement>('.prosa img').forEach((img) => {
    if (img.closest('.quadro') || img.classList.contains('retrato')) return;
    img.addEventListener('click', () => {
      abrir(img.currentSrc || img.src, img.alt, img.naturalWidth || 16, img.naturalHeight || 9);
    });
  });

  // Imagens com destaque (componente Interface): mostra a tela inteira com o destaque
  document.querySelectorAll<HTMLElement>('.prosa .quadro').forEach((quadro) => {
    quadro.addEventListener('click', () => {
      const { ampliar = '', largura = '16', altura = '9', areas = '[]' } = quadro.dataset;
      const alt = quadro.getAttribute('aria-label') ?? '';
      const lista = JSON.parse(areas) as { x: number; l: number }[];
      const centroX = lista.length ? lista.reduce((soma, a) => soma + a.x + a.l / 2, 0) / lista.length : 50;
      abrir(ampliar, alt, Number(largura), Number(altura), desenharDestaques(JSON.parse(areas)), centroX);
    });
  });

  // Fecha ao clicar em qualquer lugar (o Esc já fecha sozinho)
  dialogo?.addEventListener('click', () => dialogo.close());
</script>

<style>
  .ampliar {
    max-width: none;
    max-height: none;
    padding: 0;
    border: none;
    background: transparent;
    overflow: visible;
    cursor: zoom-out;
  }
  .ampliar.arrastar {
    max-width: 100vw;
    overflow-x: auto;
    overscroll-behavior: contain;
  }
  .ampliar::backdrop {
    background: rgb(10 8 6 / 0.88);
  }
  .ampliar :global(.ampliada) {
    position: relative;
    overflow: hidden;
    border-radius: 8px;
  }
  .ampliar :global(.ampliada img) {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 8px;
  }
</style>
