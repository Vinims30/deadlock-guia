---
// Mostra a imagem da tela do jogo escurecida, com só as áreas pedidas em destaque.
// Uso no capítulo (.mdx):  <Interface destaque="minimapa" legenda="O minimapa" />
// Vários destaques:        <Interface destaque={['vida', 'mira']} />
// Outro print:             <Interface tela="inicio" destaque="barra-inimiga" />
// Sem destaque mostra a tela inteira.
//
// Destaques pequenos aparecem aproximados (com zoom na região).
// Para mostrar a tela inteira mesmo assim: aproximar={false}
// Clicar abre a tela inteira com o destaque, em tamanho grande.
import { telas, type Area, type NomeTela } from '../data/interface';
import { desenharDestaques } from '../lib/destaques';

interface Props {
  tela?: NomeTela;
  destaque?: string | string[];
  legenda?: string;
  aproximar?: boolean;
}

const { tela = 'partida', destaque = [], legenda, aproximar = true } = Astro.props;
const { imagem, areas } = telas[tela];
const nomes = Array.isArray(destaque) ? destaque : [destaque];
const marcadas: Area[] = nomes.map((nome) => {
  const area = (areas as Record<string, Area>)[nome];
  if (!area) throw new Error(`Área "${nome}" não existe na tela "${tela}" (src/data/interface.ts)`);
  return area;
});

// Recorte: um retângulo (em % da imagem) em volta dos destaques, com uma margem.
// Ele é ajustado para não ficar estreito nem achatado demais; se acabar
// quase do tamanho da imagem, mostra a tela inteira.
const W = imagem.width;
const H = imagem.height;
let recorte = { x: 0, y: 0, l: 100, a: 100 };
if (aproximar && marcadas.length > 0) {
  const x1 = Math.min(...marcadas.map((a) => a.x));
  const y1 = Math.min(...marcadas.map((a) => a.y));
  const x2 = Math.max(...marcadas.map((a) => a.x + a.l));
  const y2 = Math.max(...marcadas.map((a) => a.y + a.a));
  // Margem em volta do destaque: o próprio tamanho dele, entre 4% e 10% da imagem.
  // Largura mínima do recorte: 30% da imagem.
  const margem = (tamanho: number) => Math.min(10, Math.max(4, tamanho));
  let l = Math.max(30, x2 - x1 + margem(x2 - x1));
  let a = y2 - y1 + margem(y2 - y1);
  // Proporção na tela entre 1,3 e 3,5 (largura / altura em pixels)
  const proporcao = (l * W) / (a * H);
  if (proporcao > 3.5) a = (l * W) / (3.5 * H);
  if (proporcao < 1.3) l = (a * H * 1.3) / W;
  l = Math.min(100, l);
  a = Math.min(100, a);
  if (l < 85 || a < 85) {
    const limitar = (v: number, tamanho: number) => Math.min(100 - tamanho, Math.max(0, v));
    recorte = {
      x: limitar((x1 + x2) / 2 - l / 2, l),
      y: limitar((y1 + y2) / 2 - a / 2, a),
      l,
      a,
    };
  }
}
const posicao = `width: ${10000 / recorte.l}%; height: ${10000 / recorte.a}%; left: ${(-recorte.x * 100) / recorte.l}%; top: ${(-recorte.y * 100) / recorte.a}%`;
const proporcaoQuadro = `${recorte.l * W} / ${recorte.a * H}`;
---

<figure class="interface">
  <div
    class="quadro"
    style={`aspect-ratio: ${proporcaoQuadro}`}
    data-ampliar={imagem.src}
    data-largura={imagem.width}
    data-altura={imagem.height}
    data-areas={JSON.stringify(marcadas)}
  >
    <div class="tela" style={posicao}>
      <img src={imagem.src} width={imagem.width} height={imagem.height} alt={legenda ?? 'A tela do jogo'} />
      <Fragment set:html={desenharDestaques(marcadas)} />
    </div>
  </div>
  {legenda && <figcaption>{legenda}</figcaption>}
</figure>

<style>
  .interface {
    margin: 2rem 0;
  }
  .quadro {
    position: relative;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid var(--borda);
    box-shadow: 0 8px 24px var(--sombra);
    cursor: zoom-in;
  }
  .tela {
    position: absolute;
  }
  .tela img {
    display: block;
    width: 100%;
    height: 100%;
  }
  figcaption {
    margin-top: 0.6rem;
    text-align: center;
    color: var(--texto-suave);
    font-size: 0.9rem;
  }
</style>
